# Copy this server block to the site configuration and replace the paths.
server {
    listen 443 ssl;
    server_name magirc.example.test;
    root /srv/www/magirc/httpdocs;
    index index.php;

    access_log /var/log/nginx/magirc.access.log;
    error_log /var/log/nginx/magirc.error.log warn;

    location ~ /\. { deny all; }

    # Pass only the intended public entry points to PHP-FPM.
    location ~ ^(?<script>/(?:index|admin/index|rest/service|setup/index)\.php)(?<pathinfo>/.*)?$ {
        try_files $script =404;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$script;
        fastcgi_param SCRIPT_NAME $script;
        fastcgi_param DOCUMENT_ROOT $document_root;
        fastcgi_param PATH_INFO $pathinfo;
        fastcgi_pass unix:/run/php/php8.4-fpm.sock;
    }

    location ~* \.php(?:/|$) { deny all; }

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }
}
