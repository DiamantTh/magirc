# Copy this virtual host to Apache and replace the paths, TLS certificate and PHP-FPM socket.
<VirtualHost *:443>
    ServerName magirc.example.test
    DocumentRoot /srv/www/magirc/httpdocs

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/magirc.example.test/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/magirc.example.test/privkey.pem

    ErrorLog ${APACHE_LOG_DIR}/magirc-error.log
    CustomLog ${APACHE_LOG_DIR}/magirc-access.log combined

    <Directory /srv/www/magirc/httpdocs>
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
        DirectoryIndex index.php
    </Directory>
    AcceptPathInfo On

    # PHP-FPM may execute only MagIRC's explicit HTTP entry points.
    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost/"
    </FilesMatch>
    <LocationMatch "^(?!/(?:index\.php|admin/index\.php|rest/service\.php|setup/index\.php)(?:/|$)).*\.php(?:/|$)">
        Require all denied
    </LocationMatch>
</VirtualHost>
