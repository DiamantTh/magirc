# Copy this virtual host to Apache and replace the paths and PHP-FPM socket.
<VirtualHost *:443>
    ServerName magirc.example.test
    DocumentRoot /srv/www/magirc

    ErrorLog ${APACHE_LOG_DIR}/magirc-error.log
    CustomLog ${APACHE_LOG_DIR}/magirc-access.log combined

    <Directory /srv/www/magirc>
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
        DirectoryIndex index.php
    </Directory>
    AcceptPathInfo On

    # Keep application internals outside the public document tree.
    <DirectoryMatch "^/srv/www/magirc/(?:conf|lib|src|doc|locale|tmp|vendor|node_modules|tests|\.git|setup/(?:inc|lib|sql|tools|tpl)|admin/(?:lib|tpl)|theme/[^/]+/(?:tpl|slim))(?:/|$)">
        Require all denied
    </DirectoryMatch>
    <FilesMatch "^(?:composer\.(?:json|lock)|package\.json|yarn\.lock|README\.md|SECURITY\.md|LICENSE|phpunit\.xml|phpcs\.xml|rector\.php|phpstan\.neon|_config\.yml)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.">
        Require all denied
    </FilesMatch>

    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !\.php(?:/|$)
    RewriteRule ^ /index.php [QSA,L]

    <FilesMatch "\.php$">
        SetHandler "proxy:unix:/run/php/php8.4-fpm.sock|fcgi://localhost/"
    </FilesMatch>
</VirtualHost>
