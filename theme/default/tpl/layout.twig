<!DOCTYPE html>
<html>
<head>
<title>{% block title %}{{ cfg.net_name }} - {% endblock %}</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<meta name="ROBOTS" content="INDEX, FOLLOW" />
<meta name="Keywords" content="{{ cfg.net_name }} MagIRC IRC Chat Statistics Denora stats phpDenora" />
<meta name="Description" content="{{ cfg.net_name }} Network Statistics powered by MagIRC" />
<meta property='og:title' content='{{ cfg.net_name }}'/>
<meta property='og:url' content='{{ constant('BASE_URL') }}'/>
<meta property='og:image' content='{{ constant('BASE_URL') }}theme/{{ cfg.theme }}/img/logofb.png'/>
<meta property='og:site_name' content='{{ cfg.net_name }}'/>
<meta property='og:description' content='{{ cfg.net_name }} Network Statistics'/>
<base href="{{ constant('BASE_URL') }}" />
<link rel="icon" href="theme/{{ cfg.theme}}/img/favicon.ico" type="image/x-icon">
{% block css %}
<link href="assets/vendor/jquery-ui/jquery-ui.min.css" rel="stylesheet" type="text/css" />
<link href="assets/vendor/datatables/dataTables.jqueryui.min.css" rel="stylesheet" type="text/css" />
<link href="assets/vendor/flag-icon/flag-icon.min.css" rel="stylesheet" type="text/css" />
<link href="theme/{{ cfg.theme }}/css/font.css" rel="stylesheet" type="text/css" />
<link href="theme/{{ cfg.theme }}/css/styles.css" rel="stylesheet" type="text/css" />
{% endblock %}
</head>
<body>
{% block body %}
<div id="header">
    <a href="./"><img src="theme/{{ cfg.theme }}/img/magirc.png" alt="MagIRC" title="" id="logo" /></a>
    <div id="menu">
        <ul>
            <li><a href="{% if not cfg.rewrite_enable %}index.php/{% endif %}network"{% if section == 'network' %} class="active"{% endif %}><span>&nbsp;{{ 'Network'|trans }}</span></a></li>
            <li><a href="{% if not cfg.rewrite_enable %}index.php/{% endif %}server"{% if section == 'server' %} class="active"{% endif %}><span>&nbsp;{{ 'Servers'|trans }}</span></a></li>
            <li><a href="{% if not cfg.rewrite_enable %}index.php/{% endif %}channel"{% if section == 'channel' %} class="active"{% endif %}><span>&nbsp;{{ 'Channels'|trans }}</span></a></li>
            <li><a href="{% if not cfg.rewrite_enable %}index.php/{% endif %}user"{% if section == 'user' %} class="active"{% endif %}><span>&nbsp;{{ 'Users'|trans }}</span></a></li>
        </ul>
    </div>
    <div id="loading"><img src="theme/{{ cfg.theme }}/img/loading.gif" alt="{{ 'Loading'|trans }}..." /></div>
</div>
<div id="main">
    {% block content %}[content placeholder]{% endblock %}
    {% if cfg.service_adsense_id %}
        <script type="text/javascript">
        google_ad_client = "{{ cfg.service_adsense_id }}";
        google_ad_width = 728;
        google_ad_height = 90;
        google_ad_format = "728x90_as";
        google_ad_type = "text_image";
        google_ad_channel ="{{ cfg.service_adsense_channel }}";
        google_alternate_color = "f9f3df";
        google_color_border = "CCCCCC";
        google_color_bg = "FFFFFF";
        google_color_link = "333333";
        google_color_text = "666666";
        google_color_url = "0066CC";
        </script>
        <div style="width:728px; margin:auto;"><script type="text/javascript" src="//pagead2.googlesyndication.com/pagead/show_ads.js"></script></div>
    {% endif %}
</div>
<div id="footer">
    <table>
        <tr>
            <td style="text-align:left;">
                <div id="selectlocale">
                    <form method="get" action="./">
                    {{ 'Language'|trans }}: <select name="locale" id="locale" autocomplete="off">
                    {% for locale,language in locales %}
                        <option value="{{ locale }}"{% if constant('LOCALE') == locale %} selected="selected"{% endif %}>{{ language }}</option>
                    {% endfor %}
                    </select>
                    </form>
                </div>
            </td>
            <td style="text-align:center;">
                {% if cfg.service_addthis %}
                <div class="addthis_toolbox addthis_default_style">
                <a class="addthis_button_preferred_1"></a>
                <a class="addthis_button_preferred_2"></a>
                <a class="addthis_button_preferred_3"></a>
                <a class="addthis_button_preferred_4"></a>
                <a class="addthis_button_compact"></a>
                <a class="addthis_counter addthis_bubble_style"></a>
                </div>
                <script type="text/javascript" src="//s7.addthis.com/js/250/addthis_widget.js#pubid="></script>
                {% endif %}
            </td>
            <td style="text-align:right;">powered by <a href="https://h9k.github.io/magirc/">MagIRC</a>{% if cfg.version_show %} v{{ constant('VERSION_FULL') }}-{{ cfg.service }}{% endif %}</td>
        </tr>
    </table>
</div>
<ul id="chanmenu" style="display:none;">
    {% if cfg.net_roundrobin %}<li data-action="irc"><a href="#"><img src="theme/{{ cfg.theme }}/img/icons/link.png" alt="" title="{{ 'Standard connection'|trans }}" style="vertical-align:middle;" /> {{ 'IRC standard connection'|trans }}</a></li>{% endif %}
    {% if cfg.net_roundrobin and cfg.net_port_ssl %}<li data-action="ircs"><a href="#"><img src="theme/{{ cfg.theme }}/img/icons/ssl.png" alt="" title="{{ 'Secure connection'|trans }}" style="vertical-align:middle;" /> {{ 'IRC secure connection'|trans }}</a></li>{% endif %}
    {% if cfg.service_webchat %}<li data-action="webchat{% if not cfg.service_webchat_urlencode %}2{% endif %}"><a href="#"><img src="theme/{{ cfg.theme }}/img/icons/webchat.png" alt="" title="{{ 'Webchat'|trans }}" style="vertical-align:middle;" /> {{ 'Webchat'|trans }}</a></li>{% endif %}
    {% if cfg.net_roundrobin and cfg.service_mibbit %}<li data-action="mibbit"><a href="#"><img src="theme/{{ cfg.theme }}/img/icons/mibbit.png" alt="" title="Mibbit" style="vertical-align:middle;" /> Mibbit</a></li>{% endif %}
</ul>
{% endblock %}
{% block js %}
<script type="text/javascript" src="assets/vendor/jquery/jquery.min.js"></script>
<script type="text/javascript" src="assets/vendor/jquery-ui/jquery-ui.min.js"></script>
<script type="text/javascript" src="assets/vendor/datatables/jquery.dataTables.min.js"></script>
<script type="text/javascript" src="assets/vendor/datatables/dataTables.jqueryui.min.js"></script>
<script type="text/javascript" src="assets/vendor/highcharts/highstock.js"></script>
<script type="text/javascript" src="assets/vendor/js-cookie/js.cookie.js"></script>
<script type="text/javascript" src="assets/vendor/moment/moment-with-locales.min.js"></script>
<script type="text/javascript">
moment.locale('{{ constant('LANG') }}');
var url_base = '{{ constant('BASE_URL') }}{% if not cfg.rewrite_enable %}index.php/{% endif %}';
var theme = '{{ cfg.theme }}';
var net_roundrobin = '{{ cfg.net_roundrobin }}';
var net_port = '{{ cfg.net_port|default('6667') }}';
var net_port_ssl = '{{ cfg.net_port_ssl }}';
var service_webchat = '{{ cfg.service_webchat }}';
var service_mibbit = '{{ cfg.service_mibbit }}';
var stats_server = '{{ cfg.service }}';
var format_datetime = '{{ 'YYYY-MM-DD hh:mm:ss'|trans }}';
var format_datetime_charts = '{{ '%Y-%m-%d %H:%M:%S'|trans }}';
var refresh_interval = {{ cfg.live_interval }} * 1000;
var mLang = {
    "Unknown": "{{ 'Unknown'|trans }}",
    "AwayAs": "{{ 'Away as'|trans }}",
    "OnlineAs": "{{ 'Online as'|trans }}",
    "Online": "{{ 'Online'|trans }}",
    "Offline": "{{ 'Offline'|trans }}",
    "Bot": "{{ 'Bot'|trans }}",
    "Service": "{{ 'Service'|trans }}",
    "Helper": "{{ 'Available for help'|trans }}",
    "Join": "{{ 'join'|trans }}",
    "Days": "{{ 'days'|trans }}",
    "Hours": "{{ 'hours'|trans }}",
    "Minutes": "{{ 'minutes'|trans }}",
    "zoom_All": "{{ 'All'|trans }}",
    "zoom_1d": "{{ '1d'|trans }}",
    "zoom_1w": "{{ '1w'|trans }}",
    "zoom_1m": "{{ '1m'|trans }}",
    "zoom_3m": "{{ '3m'|trans }}",
    "zoom_6m": "{{ '6m'|trans }}",
    "zoom_1y": "{{ '1y'|trans }}",
    "LoadError": "{{ 'Unable to load contents'|trans }}",
    "Message": "{{ 'Message'|trans }}",
    "ConnectedSince": "{{ 'Connected since'|trans }}",
    "LastQuit": "{{ 'Last quit'|trans }}",
    "UsersOnline": "{{ 'Users online'|trans }}",
    "ServersOnline": "{{ 'Servers online'|trans }}",
    "Servers": "{{ 'Servers'|trans }}",
    "Channels": "{{ 'Channels'|trans }}",
    "Users": "{{ 'Users'|trans }}",
    "Operators": "{{ 'Operators'|trans }}",
    "Total": "{{ 'Total'|trans }}",
    "Today": "{{ 'Today'|trans }}",
    "ThisWeek": "{{ 'This Week'|trans }}",
    "ThisMonth": "{{ 'This Month'|trans }}",
    "Yes": "{{ 'Yes'|trans }}",
    "No": "{{ 'No'|trans }}",
    "Never": "{{ 'Never'|trans }}",
    "On": "{{ 'on'|trans }}",
    "NoMotd": "{{ 'MOTD not available for this server'|trans }}",
    "Failed": "{{ 'Failed'|trans }}",
    "Close": "{{ 'Close'|trans }}",
    "Status": "{{ 'Status'|trans }}",
    "CountryStatistics": "{{ 'Country Statistics'|trans }}",
    "ClientStatistics": "{{ 'Client Statistics'|trans }}",
    "None": "{{ 'none'|trans }}",
    "MibbitRelDay": "{{ 'Day'|trans }}",
    "MibbitRelWeek": "{{ 'Week'|trans }}",
    "MibbitRelMonth": "{{ 'Month'|trans }}",
    "MibbitRelYear": "{{ 'Year'|trans }}",
    "DataTables": {
        "processing": "{{ 'Processing...'|trans }}",
        "loadingRecords": "{{ 'Please wait - loading...'|trans }}",
        "lengthMenu": "{{ 'Show _MENU_ entries'|trans }}",
        "zeroRecords": "{{ 'No matching records found'|trans }}",
        "emptyTable": "{{ 'No data available in table'|trans }}",
        "info": "{{ 'Showing _START_ to _END_ of _TOTAL_ entries'|trans }}",
        "infoEmpty": "{{ 'Showing 0 to 0 of 0 entries'|trans }}",
        "infoFiltered": "{{ '(filtered from _MAX_ total entries)'|trans }}",
        "infoPostFix": "",
        "infoThousands": "'",
        "search": "{{ 'Search'|trans }}:",
        "url": "",
        "aria": {
            "sortAscending": " - {{ 'click/return to sort ascending'|trans }}",
            "sortDescending": " - {{ 'click/return to sort descending'|trans }}"
        },
        "paginate": {
            "first": "{{ 'First'|trans }}",
            "previous": "{{ 'Previous'|trans }}",
            "next": "{{ 'Next'|trans }}",
            "last": "{{ 'Last'|trans }}"
        }
    }
}
</script>
<script type="text/javascript" src="js/magirc.js"></script>
<script type="text/javascript" src="theme/{{ cfg.theme }}/js/theme.js"></script>
{% endblock %}
</body>
</html>
