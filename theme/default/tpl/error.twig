{% extends "layout.twig" %}

{% block title %}{{ parent() }}{{ 'Error'|trans }}{% endblock %}

{% block content %}
    <div id="errorbox">
        <h1>{{ 'Something happened!'|trans }}</h1>
        {% if err_code == 403 or err_code == 405 %}
            {{ 'You don\'t have the rights to view the requested content'|trans }}
        {% elseif err_code ==  404 %}
            {{ 'The requested resource does not exist'|trans }}
        {% else %}
            {{ 'Unknown error'|trans }}
        {% endif %}
        <br /><sub>{{ 'Code'|trans }}: {{ err_code|default("?") }}</sub>
    </div>
{% endblock %}
