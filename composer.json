{
    "name": "magirc/magirc",
    "description": "MagIRC - Let the magirc begin!",
    "type": "project",
    "keywords": [ "irc", "denora", "anope", "stats", "statistics", "frontend" ],
    "homepage": "https://h9k.github.io/magirc",
    "license": [
        "GPL-3.0-or-later"
    ],
    "authors": [
        {
            "name": "Sebastian Vassiliou",
            "email": "h9k@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/h9k/magirc/issues",
        "forum": "https://github.com/h9k/magirc/discussions",
        "wiki": "https://github.com/h9k/magirc/wiki",
        "irc": "irc://irc.anope.org/magirc",
        "source": "https://github.com/h9k/magirc"
    },
    "require": {
        "php": ">=8.4",
        "ext-dom": "*",
        "ext-gettext": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "michelf/php-markdown": "^2.0",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0",
        "phpfastcache/phpfastcache": "^9.0",
        "slim/csrf": "^1.5",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.15",
        "slim/twig-view": "^3.4",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.4",
        "rector/rector": "^2.2",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "autoload": {
        "psr-4": {
            "MagIRC\\": "src/MagIRC/"
        },
        "classmap": [
            "lib/magirc/Config.class.php",
            "lib/magirc/ConfigStore.class.php",
            "lib/magirc/DB.class.php",
            "lib/magirc/Magirc.class.php",
            "lib/magirc/MagircDB.php",
            "lib/magirc/Security.class.php",
            "lib/magirc/services/Anope.class.php",
            "lib/magirc/services/Denora.class.php",
            "lib/magirc/services/Service.interface.php",
            "lib/magirc/objects/ChannelBase.class.php",
            "lib/magirc/objects/ServerBase.class.php",
            "lib/magirc/objects/UserBase.class.php",
            "admin/lib/Admin.class.php",
            "setup/lib/Setup.class.php"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": [
            "phpunit --testsuite 'MagIRC regression tests'",
            "sh tests/security/run.sh"
        ],
        "test:security": "sh tests/security/run.sh",
        "test:integration": "sh tests/integration/run.sh",
        "test:installation": "sh tests/installation/run.sh",
        "check": "sh scripts/check.sh read-only",
        "check:isolated": "sh scripts/check.sh isolated",
        "analyse": "phpstan analyse --no-progress --debug",
        "cs": "phpcs",
        "rector:check": "rector process --dry-run --no-progress-bar --max-changes=1000"
    }
}
